# 管理员账号
ADMIN_USERNAME=admin
# 留空则随机生成并打印到容器日志
ADMIN_PASSWORD=

# 登录态签名密钥，随便一串长随机字符。
# 不设置的话，每次重新部署容器都会掉登录态。
SECRET_KEY=change-me-to-a-long-random-string

# 时区（影响「每日限额」的重置时间点，以及日志/图表按天切分）
TZ=Asia/Shanghai

# 数据目录（Zeabur 上把持久卷挂到 /data）
DATA_DIR=/data

# 上游请求超时（秒）
CONNECT_TIMEOUT=15
REQUEST_TIMEOUT=600
