# 环境变量（全部可选，仅用于首次初始化）
#
# 注意：部署后请优先使用持久卷里的 /data/config.json 来管理账号和密钥，
#       修改该文件后重启服务即可生效，不需要重新部署。

# 数据目录（Zeabur 上把持久卷挂载到 /data）
DATA_DIR=/data

# 时区（影响每日限额的重置时间点，以及日志和图表按天切分）
TZ=Asia/Shanghai

# 首次初始化时的面板账号
ADMIN_USERNAME=admin
# 留空则随机生成。实际生效的账号密码在 /data/config.json
ADMIN_PASSWORD=

# 登录态签名密钥（可选，首次运行若无此项会自动生成并写入 config.json）
SECRET_KEY=

# 上游请求超时（秒）
CONNECT_TIMEOUT=15
REQUEST_TIMEOUT=600
