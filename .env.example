# ================= RelayHub 环境变量 =================
#
# 设计原则：
#   面板密码   -> 放环境变量。忘了密码时，改这里再重启就能找回，
#                 不会把自己锁在面板外面。
#   中转站密钥 -> 存放在持久卷的数据库里，不走环境变量。

# 面板登录密码（强烈建议设置）
# 设置后它就是唯一来源：每次启动都会把面板密码校正成这个值。
ADMIN_PASSWORD=change-me-please

# 面板登录账号（可选，默认 admin）
# 不设置 = 不干预，面板里改过的用户名会保留。
ADMIN_USERNAME=admin

# 登录态签名密钥（建议设置，随便一串长随机字符）
# 不设置也不会丢数据，会随机生成并存在持久卷里。
SECRET_KEY=

# 时区：影响「每日限额」的重置时间，以及日志/图表按天切分
TZ=Asia/Shanghai

# 数据目录（Zeabur 上把持久卷挂载到 /data）
DATA_DIR=/data

# 上游请求超时（秒）
CONNECT_TIMEOUT=15
REQUEST_TIMEOUT=600
